{
  "name": "kya-local-agent-auth",
  "version": "0.1.0",
  "private": true,
  "description": "KYA \u2014 Know Your Agent local-agent authentication on Base (ERC-8004)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mandates:postgres": "vitest run --config vitest.mandates-postgres.config.ts",
    "demo:ceremony": "tsx scripts/demo-ceremony.ts",
    "catalog:up": "docker compose -f docker-compose.catalog.yml up -d --wait",
    "catalog:down": "docker compose -f docker-compose.catalog.yml down",
    "catalog:migrate": "tsx scripts/migrate-juno-catalog.ts",
    "catalog:load": "tsx scripts/load-juno-catalog.ts",
    "catalog:provision": "tsx scripts/provision-merchant-api-key.ts",
    "catalog:revoke": "tsx scripts/revoke-merchant-api-key.ts",
    "catalog:rotate": "tsx scripts/rotate-merchant-api-key.ts",
    "catalog:worker": "tsx scripts/reindex-catalog-worker.ts",
    "catalog:harness": "tsx scripts/harness-acp-catalog.ts",
    "kya:store:migrate": "tsx scripts/kya-store-migrate.ts",
    "mandates:create": "tsx scripts/mandates-create.ts mandates:create",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:bsc-testnet": "hardhat run scripts/deploy-mandate-anchor.ts --network bscTestnet",
    "yuno:contract:update": "node scripts/update-yuno-openapi.mjs",
    "yuno:contract:verify": "node scripts/verify-yuno-openapi.mjs",
    "yuno:contract:generate": "node scripts/generate-yuno-contract.mjs",
    "yuno:contract:check-generated": "node scripts/generate-yuno-contract.mjs --check",
    "yuno:mock:start": "npm --prefix yuno_mock start",
    "yuno:mock:build": "npm --prefix yuno_mock run build",
    "yuno:mock:typecheck": "npm --prefix yuno_mock run typecheck",
    "yuno:mock:test": "npm --prefix yuno_mock test",
    "yuno:mock:lint": "npm --prefix yuno_mock run lint",
    "yuno:sandbox:readiness": "tsx scripts/yuno-sandbox-readiness.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coinbase/cdp-core": "^0.0.123",
    "@coinbase/cdp-hooks": "^0.0.123",
    "@coinbase/cdp-react": "^0.0.123",
    "@coinbase/cdp-sdk": "^1.55.0",
    "@hono/node-server": "^1.14.4",
    "@huggingface/transformers": "^3.7.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@supabase/supabase-js": "^2.112.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "^4.8.5",
    "jose": "^6.0.11",
    "pg": "^8.16.3",
    "viem": "^2.33.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "hardhat": "^3.15.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
