{
  "name": "kya-local-agent-auth",
  "version": "0.1.0",
  "private": true,
  "description": "KYA — Know Your Agent local-agent authentication on Base (ERC-8004)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:ceremony": "tsx scripts/demo-ceremony.ts",
    "demo:purchase": "tsx scripts/demo-purchase.ts",
    "demo:purchase:configured": "node --env-file=.env --import tsx scripts/demo-purchase-configured.ts",
    "generate:mandate-signing-jwk": "tsx scripts/generate-mandate-signing-jwk.ts",
    "mandates:create": "tsx scripts/mandates-create.ts mandates:create",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:bsc-testnet": "hardhat run scripts/deploy-mandate-anchor.ts --network bscTestnet"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-org/account": "^2.4.0",
    "@hono/node-server": "^1.14.4",
    "@openzeppelin/contracts": "^5.6.1",
    "@supabase/supabase-js": "^2.112.4",
    "hono": "^4.8.5",
    "jose": "^6.0.11",
    "viem": "^2.33.2",
    "zod": "^3.25.76"
  },
  "overrides": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "hardhat": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
