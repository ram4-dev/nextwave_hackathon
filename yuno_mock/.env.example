# yuno-rest-mock — environment example

# Independent Yuno REST mock — safe fixtures only. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Accepted by the mock as public-api-key / private-secret-key headers.
YUNO_PUBLIC_API_KEY=yuno_public_test_key
YUNO_PRIVATE_SECRET_KEY=yuno_private_test_key

# HMAC secret for stable card fingerprints (test/dev default only).
YUNO_MOCK_FINGERPRINT_SECRET=yuno_mock_fingerprint_test_secret

# AES-256 key (64-char hex or 32-byte base64) for encrypting webhook signing
# secrets at rest. Dev/test default is applied when unset; production fail-closed.
YUNO_MOCK_SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Background work-processor poll interval (ms) for webhook retries + async actions.
# Integer in [100, 600000]; default 1000. Owned by main(), not createApp.
YUNO_MOCK_WORK_POLL_MS=1000

# memory | file
YUNO_STORE_BACKEND=memory
YUNO_DATA_DIR=.yuno-data
