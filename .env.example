# KYA runtime
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
KYA_ISSUER=http://localhost:8787
KYA_AUDIENCE=kya-agent
KYA_MODE=demo
KYA_DATA_DIR=.kya-data
CREDENTIAL_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=120
NONCE_TTL_SECONDS=300
PAYMASTER_CAPABILITY_TTL_SECONDS=300
KYC_TTL_DAYS=365

# Base / ERC-8004 (live mode)
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
MAINNET_PROMOTION_ENABLED=false
MAINNET_REGISTRY_VERIFIED=false

# Paymaster proxy (server-side only; never send provider credentials to the browser)
PAYMASTER_PROXY_ENABLED=false
PAYMASTER_URL=

# Didit (primary MVP live KYC)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE=https://verification.didit.me/v3

# Incode Omni (Colombia production)
INCODE_API_KEY=
INCODE_API_URL=
INCODE_HARDWARE_ID=
INCODE_API_BEARER_TOKEN=
INCODE_FLOW_ID=
# Webhook auth: custom_header (Dashboard static header) or oauth_bearer — not HMAC
INCODE_WEBHOOK_AUTH_MODE=custom_header
INCODE_WEBHOOK_SECRET=
INCODE_WEBHOOK_SECRET_HEADER=x-incode-secret
INCODE_WEBHOOK_BEARER_TOKEN=

# Veriff (global fallback)
VERIFF_API_KEY=
VERIFF_API_SECRET=
VERIFF_API_URL=https://stationapi.veriff.com
VERIFF_WEBHOOK_SECRET=

# SIWB presentation (client)
SIWB_DOMAIN=localhost
SIWB_URI=http://localhost:5173

# Platform ES256 signing (live fail-closed; demo uses in-memory ephemeral key)
# Provide exactly one in live mode — never commit real values
KYA_SIGNING_PRIVATE_JWK=
KYA_SIGNING_KEY_FILE=
