# KYA runtime
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
KYA_ISSUER=http://localhost:8787
KYA_AUDIENCE=kya-agent
KYA_MODE=demo
KYA_DATA_DIR=.kya-data
CREDENTIAL_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=120
NONCE_TTL_SECONDS=300
KYC_TTL_DAYS=365

# Base / ERC-8004 (live mode)
# Official public Base Sepolia RPC (chain 84532). Rate-limited; use a dedicated provider in production.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=
MAINNET_PROMOTION_ENABLED=false
MAINNET_REGISTRY_VERIFIED=false

# Didit (primary MVP live KYC)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE=https://verification.didit.me/v3

# Incode Omni (Colombia production)
INCODE_API_KEY=
INCODE_API_URL=
INCODE_HARDWARE_ID=
INCODE_API_BEARER_TOKEN=
INCODE_FLOW_ID=
# Webhook auth: custom_header (Dashboard static header) or oauth_bearer — not HMAC
INCODE_WEBHOOK_AUTH_MODE=custom_header
INCODE_WEBHOOK_SECRET=
INCODE_WEBHOOK_SECRET_HEADER=x-incode-secret
INCODE_WEBHOOK_BEARER_TOKEN=

# Veriff (global fallback)
VERIFF_API_KEY=
VERIFF_API_SECRET=
VERIFF_API_URL=https://stationapi.veriff.com
VERIFF_WEBHOOK_SECRET=

# SIWE presentation (client)
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173/app/

# Platform ES256 signing (live fail-closed; demo uses an in-memory ephemeral key).
# Provide exactly one in live mode. Prefer Vault injection; never commit a private JWK.
# Option A: inline ES256 private JWK JSON injected into the process environment.
KYA_SIGNING_PRIVATE_JWK=
# Option B: path to a Vault/KMS-mounted ES256 private JWK file with restrictive permissions.
KYA_SIGNING_KEY_FILE=

# Juno catalog (optional; KYA stays up if unset — search returns 503 CATALOG_UNAVAILABLE).
# The only catalog route is public POST /v1/catalog/search; auth is intentionally deferred.
# Local Docker: npm run catalog:up && CATALOG_DATABASE_URL=postgres://catalog:catalog@127.0.0.1:55432/juno_catalog
CATALOG_DATABASE_URL=
CATALOG_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Test-only loader override: set CATALOG_EMBEDDING_PROVIDER=deterministic to skip the local model download.
# Rollback: set either flag to false to pause ACP routes or the reindex worker without dropping SQL.
CATALOG_ACP_ENABLED=true
CATALOG_WORKER_ENABLED=true
CATALOG_WORKER_LEASE_SECONDS=30
CATALOG_WORKER_MAX_ATTEMPTS=5
# Optional in-process ACP mutation cap per merchant window. Omit to disable.
CATALOG_ACP_RATE_LIMIT=

# AP2 mandate drafts (local domain library; never commit real keys)
# Local merchant ES256 signer is development/test only. Prefer injecting MerchantSigner in production.
MERCHANT_SIGNING_PRIVATE_JWK=
MANDATES_ALLOW_FULL_OUTPUT=false

# BSC Testnet mandate evidence anchor (never commit a real private key; live writes are out of scope for the hash-only outbox worker)
BSC_TESTNET_RPC_URL=
MANDATE_ANCHOR_DEPLOYER_PRIVATE_KEY=
MANDATE_ANCHOR_ADMIN=
MANDATE_ANCHOR_PAUSER=
MANDATE_ANCHORER=

# Supabase (mandate policy ledger / request store; placeholders only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>

# Mandate placeholder for a *separate* authorization-policy module.
# Must NOT be used by PaymentService as payment authorization.
MANDATE_MAX_AMOUNT=500

# --- Payments (F6/F7) — provider-neutral Yuno HTTP ---
# Provider mode: mock (default, local fixtures) | sandbox | production.
# sandbox/production never fall back to fixture keys; require HTTPS YUNO_BASE_URL
# (not legacy YUNO_MOCK_URL), UUID YUNO_ACCOUNT_ID, and explicit non-fixture secrets.
# Offline check: npm run yuno:sandbox:readiness (no-arg success needs live mode).
YUNO_PROVIDER_ENV=mock

# Point at the independent yuno_mock process (dev) or real Yuno (sandbox/production).
# Blank/unset → payment routes return 503; KYA ceremony routes still run.
YUNO_BASE_URL=http://127.0.0.1:8080
YUNO_PUBLIC_API_KEY=yuno_public_test_key
YUNO_PRIVATE_SECRET_KEY=yuno_private_test_key
# UUID account_id required by provider create-payment bodies.
YUNO_ACCOUNT_ID=493e9374-510a-4201-9e09-de669d75f256
YUNO_WEBHOOK_HMAC_SECRET=yuno_platform_webhook_hmac_test_secret
YUNO_HTTP_TIMEOUT_MS=15000

# AES-256 key (64-char hex or 32-byte base64) for vaulted_token at rest.
# Dev/test default applied when unset in mock mode; sandbox/production require explicit non-fixture key.
PAYMENT_SECRETS_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
PAYMENT_DATA_DIR=.kya-data

# Explicit admin / internal-service keys (safe fixtures only in .env.example).
PAYMENT_ADMIN_API_KEY=payment_admin_test_key
PAYMENT_INTERNAL_API_KEY=payment_internal_test_key
